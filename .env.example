# Qdrant Vector Store Config
QDRANT_MODE=disk
QDRANT_PATH=./qdrant_storage
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=rag_documents

# Embeddings & Reranker
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# Gemini LLM Key (Optional - if blank, offline synthesizer will be used)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Local Ollama Fallback Settings (Optional - falls back here if Gemini fails/hits limits)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Firebase Configuration ───────────────────────────────────────────────────
# Step 1: Go to https://console.firebase.google.com/ → Create a project
# Step 2: Enable Firestore Database (Native mode)
# Step 3: Enable Storage
# Step 4: Go to Project Settings → Service Accounts → Generate new private key
#          → Download the JSON file → save as serviceAccountKey.json in project root
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # Inline JSON alternative
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ─── Admin Panel ──────────────────────────────────────────────────────────────
# Password required to access the Admin Panel tab in the Streamlit frontend
ADMIN_PASSWORD=change_me_to_something_strong
